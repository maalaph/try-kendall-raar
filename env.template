# Environment Variables Template
# Copy this file to .env.local and fill in your actual values
# DO NOT commit .env.local to git (it's in .gitignore)

# Supabase Configuration (PostgreSQL Database)
SUPABASE_URL=https://kwlkbuatidinolgfsxst.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
SUPABASE_DB_URL=postgresql://postgres:[YOUR_PASSWORD]@db.kwlkbuatidinolgfsxst.supabase.co:5432/postgres

# Airtable Configuration (REMOVED - All data migrated to Supabase)
# No longer needed - all functionality uses Supabase PostgreSQL

# VAPI Configuration
VAPI_PRIVATE_KEY=your_vapi_private_key
VAPI_DEFAULT_MODEL=gpt-4o
VAPI_COUNTRY=US

# Ngrok Webhook URL (Required for VAPI functions to work)
# Replace 'your-domain.ngrok.app' with your actual Ngrok domain
# Get your domain from: https://dashboard.ngrok.com/domains
# Domain ID: rd_36PUWsmItHti5ks0d5Gp1J7OG9v
VAPI_WEBHOOK_URL=https://your-domain.ngrok.app/api/vapi-webhook

# Alternative webhook URL (if VAPI_WEBHOOK_URL is not set)
# NEXT_PUBLIC_WEBHOOK_URL=https://your-domain.ngrok.app/api/vapi-webhook

# SMS Webhook URL (Optional - for Twilio SMS)
# SMS_WEBHOOK_URL=https://your-domain.ngrok.app/api/twilio-sms-webhook

# Base URL (Optional - for email links and other absolute URLs)
# NEXT_PUBLIC_BASE_URL=https://your-domain.ngrok.app

# Twilio Configuration (Optional - for phone number purchase)
# TWILIO_ACCOUNT_SID=your_twilio_account_sid
# TWILIO_AUTH_TOKEN=your_twilio_auth_token

# Google OAuth (Optional - for Google Calendar/Gmail integration)
# GOOGLE_CLIENT_ID=your_google_client_id
# GOOGLE_CLIENT_SECRET=your_google_client_secret

# Spotify OAuth (Optional - for Spotify integration)
# SPOTIFY_CLIENT_ID=your_spotify_client_id
# SPOTIFY_CLIENT_SECRET=your_spotify_client_secret

# Mapbox Configuration (for geocoding, maps, and location features)
# Get your token from: https://account.mapbox.com/access-tokens/
MAPBOX_ACCESS_TOKEN=your_mapbox_access_token
# Public token for frontend map rendering (can be same as above for development)
NEXT_PUBLIC_MAPBOX_TOKEN=your_mapbox_public_token

# OpenAI (Optional - if using OpenAI directly)
# OPENAI_API_KEY=your_openai_api_key

# Trigger.dev Configuration (for async learning loops)
# Required for background task processing (message indexing, pattern extraction)
# Note: Trigger.dev v4 requires TRIGGER_SECRET_KEY (not TRIGGER_API_KEY)
TRIGGER_SECRET_KEY=your_trigger_secret_key
TRIGGER_PROJECT_ID=your_trigger_project_id
# Legacy support (optional - will use TRIGGER_SECRET_KEY if both are set)
# TRIGGER_API_KEY=your_trigger_api_key

# LangGraph Configuration (optional - for advanced agent orchestration)
# Set to 'true' to use LangGraph instead of OpenAI function calling
# LangGraph provides: state persistence, self-correction loops, multi-agent orchestration
USE_LANGGRAPH=true
# Note: LangGraph checkpointing requires SUPABASE_DB_URL to be set for state persistence

